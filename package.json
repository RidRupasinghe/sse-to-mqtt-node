{
  "name": "sse-to-mqtt",
  "version": "1.0.0",
  "description": "A Node.js app that listens to SSE and publishes to MQTT",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "dotenv": "^16.5.0",
    "mqtt": "^5.0.1",
    "qs": "^6.14.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/qs": "^6.14.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ]
}
